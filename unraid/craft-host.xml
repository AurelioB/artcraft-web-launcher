<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <Name>craft-host</Name>
  <Repository>ghcr.io/aureliob/craft-host:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>

  <Support>https://github.com/AurelioB/craft-server/issues</Support>
  <Project>https://github.com/AurelioB/craft-server</Project>
  <Overview>Self-hosted Craft browser applications with automatic release management.</Overview>
  <Category>Productivity:</Category>

  <WebUI>http://[IP]:[PORT:8080]/</WebUI>

  <ExtraParams>--user=99:100 --read-only --cap-drop=ALL --security-opt=no-new-privileges --init --tmpfs=/tmp:mode=1777,size=16m --workdir=/srv/work</ExtraParams>

  <Config Name="WebUI Port" Target="8080"
    Default="8080" Mode="tcp"
    Description="HTTP interface"
    Type="Port" Display="always"
    Required="true" Mask="false">8080</Config>

  <Config Name="Configuration" Target="/config"
    Default="/mnt/user/appdata/craft-host/config"
    Mode="ro" Description="Configuration files"
    Type="Path" Display="always"
    Required="true" Mask="false">/mnt/user/appdata/craft-host/config</Config>

  <Config Name="App Data" Target="/srv/data"
    Default="/mnt/user/appdata/craft-host/data"
    Mode="rw" Description="Installed app releases"
    Type="Path" Display="always"
    Required="true" Mask="false">/mnt/user/appdata/craft-host/data</Config>

  <Config Name="State" Target="/srv/state"
    Default="/mnt/user/appdata/craft-host/state"
    Mode="rw" Description="Persistent application state"
    Type="Path" Display="always"
    Required="true" Mask="false">/mnt/user/appdata/craft-host/state</Config>

  <Config Name="Cache" Target="/srv/cache"
    Default="/mnt/user/appdata/craft-host/cache"
    Mode="rw" Description="Release download cache"
    Type="Path" Display="always"
    Required="true" Mask="false">/mnt/user/appdata/craft-host/cache</Config>

  <Config Name="Work" Target="/srv/work"
    Default="/mnt/user/appdata/craft-host/work"
    Mode="rw" Description="Temporary download workspace"
    Type="Path" Display="always"
    Required="true" Mask="false">/mnt/user/appdata/craft-host/work</Config>

  <Config Name="FILE_UMASK" Target="FILE_UMASK"
    Default="0002" Mode=""
    Description="File creation permissions"
    Type="Variable" Display="advanced"
    Required="false" Mask="false">0002</Config>

  <Config Name="CRAFT_LOG_LEVEL" Target="CRAFT_LOG_LEVEL"
    Default="info" Mode=""
    Description="Application logging level"
    Type="Variable" Display="advanced"
    Required="false" Mask="false">info</Config>

  <Config Name="RUN_UID" Target="RUN_UID"
    Default="99" Mode=""
    Description="UID for diagnostics; keep aligned with Extra Parameters"
    Type="Variable" Display="advanced"
    Required="false" Mask="false">99</Config>

  <Config Name="RUN_GID" Target="RUN_GID"
    Default="100" Mode=""
    Description="GID for diagnostics; keep aligned with Extra Parameters"
    Type="Variable" Display="advanced"
    Required="false" Mask="false">100</Config>
</Container>
